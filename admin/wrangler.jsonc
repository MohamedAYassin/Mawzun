{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawzun-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3425ee24fee340ea8d9300ff19319c52"
    }
  ],
  // Worker logs + traces to Cloudflare's own store, matching the other
  // services. Without this block an error in this Worker is only visible if
  // someone happens to be tailing it — the back-office, where a failure means
  // platform staff cannot act during an incident, was the one place that had
  // no trail at all.
  //
  // These are Cloudflare-side logs, not the error_log breadcrumb table: this
  // Worker deliberately does not write breadcrumbs itself, because it is the
  // thing that READS them.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    // Same live DB-URL resolution as the AI API: Heroku stays source of truth.
    "HEROKU_APP_NAME": "mawzun"
    // Secrets to set once:
    //   npx wrangler secret put ADMIN_PASSWORD
    //   npx wrangler secret put HEROKU_API_TOKEN
  }
}
