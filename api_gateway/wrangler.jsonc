{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawzun-app-ai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3425ee24fee340ea8d9300ff19319c52"
    }
  ],
  "vars": {
    // DB URL is fetched from Heroku's own Platform API at startup — NOT preset,
    // and NEVER via a sibling service — so rotation heals automatically.
    "HEROKU_APP_NAME": "mawzun",
    // Low-stock threshold for GET /v1/stock/levels `lowStock` list (?lowStock= overrides).
    "AI_LOW_STOCK_THRESHOLD": "5",
    // Redis: the AI API uses the REST endpoint via fetch(), not a socket client.
    // Cloudflare's runtime pools those HTTP connections itself, so there is no
    // connection object to size here — the budget is 2 upstream connections and
    // is enforced by the provider, not by this worker.
    // (Contrast the backend, which holds a real pool: REDIS_POOL_MAX there.)
    //
    // Per-key throttle: 600 req/min default. Unset UPSTASH_* = fail-open.
    // Kill switch: AI_RATE_LIMIT_DISABLED=0/false/no (unset = on).
    "AI_RATE_LIMIT_MAX": "600",
    "AI_RATE_LIMIT_WINDOW_MS": "60000"
    // Secrets to set once: npx wrangler secret put HEROKU_API_TOKEN
    //   (create it with: heroku authorizations:create -d "mawzun-workers-db-url")
    // Rate-limit secrets — Layerbase's Upstash-compatible REST endpoint. Copy
    // the REST URL + REST Token from the database's Connect dialog:
    //   npx wrangler secret put UPSTASH_REDIS_REST_URL
    //   npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
