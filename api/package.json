{
  "name": "backend-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "heroku-postbuild": "npm run build",
    "start": "npm run prisma:migrate && node dist/index.js",
    "seed": "npm run build && npm run prisma:migrate && npm run prisma:seed && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 --import ./tests/setup.mjs tests/*.test.ts",
    "test:watch": "tsx --test --watch --test-concurrency=4 --import ./tests/setup.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:seed": "prisma db seed",
    "db:provision": "node --env-file=.env scripts/provision-db.mjs",
    "db:reset": "prisma migrate reset --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "fengari": "^0.1.5",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^8.8.0",
    "snappyjs": "^0.7.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
