{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawzun-cleanup-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3425ee24fee340ea8d9300ff19319c52"
    }
  ],
  "triggers": {
    // Nightly, 02:17 UTC. Deliberately not on the hour: every cron in the
    // fleet would otherwise wake at the same instant and contend for the
    // database at its quietest moment.
    "crons": ["17 2 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    // DB URL is fetched from Heroku's own Platform API at startup — NOT preset,
    // and NEVER via a sibling service — so rotation heals automatically.
    "HEROKU_APP_NAME": "mawzun",

    // ── Retention windows, in days ────────────────────────────────────────
    // Every one of these is a policy decision, so they live here where an
    // operator can see and change them without reading the code. 0 disables
    // that sweep entirely — useful for a self-hoster who wants to keep
    // everything, and the reason each sweep is independent.

    // Sessions: revoked or expired rows are history. Kept longer than the
    // longest refresh token (remember-me = 30 days) because a REPLAYED revoked
    // token is how stolen-token reuse is detected (auth.service.ts: a revoked
    // token arriving again revokes every session for that user). Delete too
    // eagerly and an old token simply fails to match instead of raising the
    // alarm, silently disarming that check.
    "SESSION_RETENTION_DAYS": "45",
    // Password reset: single-use, and a used row's only purpose is "this link
    // is dead". A day is generous.
    "PASSWORD_RESET_RETENTION_DAYS": "1",
    // Notifications: READ rows only, at the operator's request. Unread rows are
    // the user's inbox and are never touched — and deleting them would also
    // defeat the low-stock anti-spam keys, which suppress duplicates only
    // while an unread row with the same action exists.
    "NOTIFICATION_RETENTION_DAYS": "14",
    // Resolved/ignored sync errors are an audit trail of fixed problems.
    "SYNC_ERROR_RETENTION_DAYS": "90",
    // Audit logs are the record of who did what. A year is the shortest
    // defensible window; 0 here would be the wrong default.
    "AUDIT_LOG_RETENTION_DAYS": "365"

    // Secrets to set once: npx wrangler secret put HEROKU_API_TOKEN
    //   (create it with: heroku authorizations:create -d "mawzun-workers-db-url")
  }
}
